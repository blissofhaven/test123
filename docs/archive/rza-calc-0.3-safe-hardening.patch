+@echo off
+chcp 65001 >nul
+set PYTHONIOENCODING=utf-8
+set PYTHONUTF8=1
+cd /d "%~dp0"
+
+where python >nul 2>nul
+if errorlevel 1 (
+  echo.
+  echo Python не найден.
+  echo Установите его с python.org и обязательно отметьте галочку
+  echo "Add python.exe to PATH" на первом экране установщика.
+  echo.
+  pause
+  exit /b 1
+)
+
+python -c "import numpy" 2>nul
+if errorlevel 1 (
+  echo Устанавливаю numpy...
+  python -m pip install numpy
+)
+
+echo.
+python -m rza_calc example report > "Отчёт ПС Северная.txt"
+echo Полный отчёт сохранён в файл "Отчёт ПС Северная.txt"
+echo.
+python -m rza_calc example table
+echo.
+pause
